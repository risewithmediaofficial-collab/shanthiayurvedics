# ==============================================================================
# Shanthi Ayurvedas CRM — Root Environment Configuration Template
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=SecureAdminPassword123
MONGODB_URI=mongodb://admin:SecureAdminPassword123@mongodb:27017/shanthi_ayurvedas_crm?authSource=admin
MONGO_URI=mongodb://admin:SecureAdminPassword123@mongodb:27017/shanthi_ayurvedas_crm?authSource=admin

# JWT Security Secrets (Replace with random strings in production)
JWT_ACCESS_SECRET=production_secure_jwt_access_key_crm_94829471948201948201
JWT_REFRESH_SECRET=production_secure_jwt_refresh_key_crm_58392819485720194820
COOKIE_SECRET=production_secure_cookie_secret_crm_71829401827401928401
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Token Expirations
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Application URLs
FRONTEND_URL=http://82.29.166.169:8087
CRM_PORT=8087
CRM_ALT_PORT=89
TRUST_PROXY_HOPS=0
DB_MAX_POOL_SIZE=20
VITE_API_URL=/api

# Logging
LOG_LEVEL=info

# SMTP Configuration (Optional: Ethereal / SendGrid / SES)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@shanthiayurvedas.com

# WhatsApp Cloud API (Optional)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
