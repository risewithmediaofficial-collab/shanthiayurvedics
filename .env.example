# ==============================================================================
# Shanthi Ayurvedas CRM — Root Environment Configuration Template
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/shanthi_ayurvedas_crm
MONGO_URI=mongodb://127.0.0.1:27017/shanthi_ayurvedas_crm

# JWT Security Secrets (Replace with random strings in production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
COOKIE_SECRET=your_super_secret_cookie_signing_key_min_32_chars
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Token Expirations
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Application URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Logging
LOG_LEVEL=info

# SMTP Configuration (Optional: Ethereal / SendGrid / SES)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@shanthiayurvedas.com

# WhatsApp Cloud API (Optional)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
